# Copy to .env for local (non-Docker) development.
# When running via docker-compose, these are set automatically in
# docker-compose.yml and this file is not needed.

DATABASE_URL=postgresql+psycopg2://menu_user:menu_password@localhost:5432/menu_db

# --- Multi-tenancy -----------------------------------------------------
# Set to "false" once you have real tenant domains/subdomains configured.
# Leaving it "true" in production means any unmapped domain resolves to
# tenant #1 — fine for a demo, not fine for a real multi-tenant launch.
TENANT_DEV_FALLBACK=true

# Comma-separated list of allowed browser origins. "*" (the default) is
# fine for a demo; list the real tenant domains in production, e.g.
# CORS_ORIGINS=https://menu.example.com,https://cafe.example.com
CORS_ORIGINS=*

# Password given to the seeded demo tenants' /admin login (seed.py).
DEMO_ADMIN_PASSWORD=admin123

# Shared secret required in the `X-Platform-Admin-Key` header to create
# or edit tenants via /api/v1/platform/tenants. Generate a long random
# value — e.g. `openssl rand -hex 32` — and keep it out of source control.
PLATFORM_ADMIN_KEY=

# Signs the JWTs issued by a tenant's own POST /api/v1/admin/auth/login.
# Falls back to an insecure dev value if unset — always set a real one
# (e.g. `openssl rand -hex 32`) outside of local development.
JWT_SECRET=

# --- Cloudflare R2 (image storage) -------------------------------------
# Create a bucket + API token in the Cloudflare dashboard (R2 > Manage
# API Tokens), then either enable the bucket's public r2.dev URL or
# attach a custom domain to it for R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://your-bucket.your-account.r2.dev
