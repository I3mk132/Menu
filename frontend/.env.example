# Copy to .env for local `npm run dev`.
# When running via docker-compose, these are passed in as build
# arguments instead (see docker-compose.yml), since Vite bakes env vars
# into the build at compile time.

VITE_API_URL=http://localhost:8000

# Only needed for local/demo use. On "localhost" there's no real tenant
# domain for the backend to resolve, so this tells it which tenant to
# serve via the X-Tenant-Slug header. Try "local-table" or "sunset-diner"
# (see backend/seed.py). Leave unset in real deployments — each tenant's
# own custom domain resolves them automatically.
VITE_TENANT_SLUG=local-table
